# DJ AI backend environment
# Never commit a real .env file or production secrets.

# AI providers
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_api_key
MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# Security
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=7d
TURNSTILE_SECRET=replace_with_cloudflare_turnstile_secret

# Database / pgvector
DATABASE_URL=postgresql://user:password@host:5432/djai
DATABASE_SSL=true
DB_POOL_MAX=10

# Browser / app
PUBLIC_APP_URL=https://deeepanbe.github.io
BACKEND_URL=https://your-dj-api.example.com
TURNSTILE_SITE_KEY=replace_with_public_turnstile_site_key
CORS_ORIGINS=http://localhost:8000,https://deeepanbe.github.io

# Google authentication (configure when enabling Google Sign-In)
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id

# Email verification (Resend-compatible HTTP API)
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=DJ AI <noreply@example.com>

# Stripe billing
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_PRICE_PRO=replace_with_stripe_price_id
STRIPE_PRICE_TEAM=replace_with_stripe_price_id

# Runtime limits
PORT=8787
TRUST_PROXY=false
IP_RATE_LIMIT=30
SESSION_LIMIT=10
SESSION_WINDOW_MS=300000
MAX_MESSAGE_LENGTH=5000
MAX_OUTPUT_TOKENS=1200

# AI provider reliability
AI_REQUEST_TIMEOUT_MS=25000
AI_REQUEST_MAX_RETRIES=2

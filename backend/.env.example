# Backend environment example

# OpenAI API key (do NOT commit your real key)
OPENAI_API_KEY=sk-REPLACE_ME

# A secret value that the frontend must send in x-backend-secret header to call the /chat endpoint
BACKEND_SECRET=supersecretvalue

# Comma-separated list of allowed CORS origins (e.g. https://yourdomain.com)
CORS_ORIGINS=http://localhost:8000,https://deeepanbe.github.io

# Model to use
MODEL=gpt-5.6-luna

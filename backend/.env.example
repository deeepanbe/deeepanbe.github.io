# DJ AI backend environment
# Never commit a real .env file or production secrets.

OPENAI_API_KEY=sk-REPLACE_ME
AI_PROVIDER=openai
MODEL=gpt-5.6-luna

# Cloudflare Turnstile server secret. Keep this ONLY on the backend.
TURNSTILE_SECRET=replace_with_cloudflare_turnstile_secret

# Browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:8000,https://deeepanbe.github.io

PORT=8787
TRUST_PROXY=false
IP_RATE_LIMIT=30
SESSION_LIMIT=10
SESSION_WINDOW_MS=300000
MAX_MESSAGE_LENGTH=5000
MAX_OUTPUT_TOKENS=800
